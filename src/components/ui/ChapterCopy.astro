---
/**
 * The real, machine-readable copy for a scene that renders its text through
 * the pinned Chapter block.
 *
 * Visually hidden, because the Chapter block paints it — but present in the
 * document in correct reading order, exposed to assistive tech, available to
 * crawlers, and visible if JavaScript never arrives. The call to action is a
 * genuine link that reveals itself on focus, so keyboard users can still
 * reach it.
 */
interface Props {
  as?: string;
  title: string;
  /** appended to the call to action so the link text names its destination */
  body: string | string[];
  cta?: string;
  href?: string;
}

const { as: Tag = 'h2', title, body, cta, href = '#' } = Astro.props;
const paragraphs = Array.isArray(body) ? body : [body];
---

<div class="sr-only">
  <Tag>{title}</Tag>
  {paragraphs.map((paragraph) => <p>{paragraph}</p>)}
  {
    cta && (
      <a
        href={href}
        data-shape="slab"
        class="focus:not-sr-only focus:fixed focus:bottom-6 focus:left-6 focus:z-100 focus:bg-accent focus:px-6 focus:py-3 focus:font-display focus:text-xs focus:tracking-[0.3em] focus:text-white focus:uppercase"
      >
        {cta} — {title}
      </a>
    )
  }
</div>
