---
import DecryptText from '../ui/DecryptText.astro';

interface Props {
  label: string;
  /** which of the seven slashes is lit - doubles as the chapter position */
  step?: number;
  class?: string;
}

const { label, step = 1, class: className = '' } = Astro.props;
const slashes = Array.from({ length: 7 }, (_, i) => i + 1);
---

<div class:list={['flex items-center gap-4', className]}>
  <DecryptText
    text={label}
    class="font-display text-sm font-semibold tracking-[0.15em] text-white underline decoration-white/60 underline-offset-4"
  />
  <span class="flex gap-[3px]" aria-hidden="true">
    {
      slashes.map((i) => (
        <span
          class:list={[
            'h-3 w-[3px] skew-x-[-20deg]',
            i === step ? 'bg-accent' : 'bg-white/70',
          ]}
        />
      ))
    }
  </span>
</div>
