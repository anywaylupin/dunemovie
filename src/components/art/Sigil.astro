---
/**
 * House sigils, as inline SVG.
 *
 * Inline rather than an <img> for two reasons: they inherit `currentColor`,
 * so one mark serves both the white-on-photo faction panel and the tinted
 * house card without a second file; and at three marks totalling under 4 kB
 * there is no request worth making.
 *
 * An id with no drawn mark renders nothing, deliberately — the caller
 * decides what stands in its place (see GreatHouses, which keeps its
 * lettered ring for the two houses and the Guild). Callers that need to
 * know in advance import `hasSigil` from config/sigils.
 */
import { sigils } from '../../config/sigils';

interface Props {
  /** faction or house id; unknown ids render nothing */
  id: string;
  class?: string;
}

const { id, class: className = '' } = Astro.props;
const sigil = sigils[id];
---

{
  sigil && (
    <svg
      viewBox={sigil.viewBox}
      fill="currentColor"
      aria-hidden="true"
      focusable="false"
      class:list={['block', className]}
    >
      {sigil.paths.map((d) => (
        <path fill-rule="evenodd" clip-rule="evenodd" d={d} />
      ))}
    </svg>
  )
}
