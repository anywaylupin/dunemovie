---
/**
 * The transport in the hero.
 *
 * Static markup wired to the shared player by scripts/audio-controls.ts —
 * no island. Everything it renders is the pre-playback state read from the
 * copy, so the bar is complete and correct before any script runs and
 * simply comes alive when one does.
 */
import Waveform from './Waveform.astro';
import type { Copy } from '../../i18n/copy';

interface Props {
  track: string;
  elapsed: string;
  duration: string;
  labels: Copy['player'];
  progress?: number;
  class?: string;
}

const { track, elapsed, duration, labels, progress = 0, class: className = '' } = Astro.props;
---

{/*
  The labels ride on data-* rather than being looked up by the script,
  which keeps every user-facing string in src/content — including the ones
  that only ever appear as an aria-label.
*/}
<div
  data-slot="audio-bar"
  data-available="false"
  data-label-play={labels.play}
  data-label-pause={labels.pause}
  data-label-mute={labels.mute}
  data-label-unmute={labels.unmute}
  data-label-unavailable={labels.unavailable}
  class:list={['flex items-center gap-4 sm:gap-6', className]}
>
  <button
    type="button"
    data-audio-step="-1"
    class="hidden size-11 shrink-0 place-items-center rounded-full text-white/70 transition-colors hover:text-white sm:grid"
    aria-label={labels.previous}
  >
    <svg viewBox="0 0 24 24" class="size-4 fill-current" aria-hidden="true">
      <path d="M7 6h2v12H7zm10 0v12l-8-6z"></path>
    </svg>
  </button>

  {/*
    One button, both icons — CSS shows the right one from data-state, so
    the label is the only thing the script has to keep in step.
  */}
  <button
    type="button"
    data-audio-toggle
    data-state="paused"
    class="group grid size-11 shrink-0 place-items-center rounded-full ring-1 ring-white/40 transition-colors hover:ring-white disabled:cursor-not-allowed disabled:opacity-40 disabled:hover:ring-white/40"
    aria-label={labels.play}
  >
    <svg viewBox="0 0 24 24" class="size-4 fill-white group-data-[state=playing]:hidden" aria-hidden="true">
      <path d="M8 5v14l11-7z"></path>
    </svg>
    <span class="hidden gap-[3px] group-data-[state=playing]:flex" aria-hidden="true">
      <span class="h-3 w-[2px] bg-white"></span>
      <span class="h-3 w-[2px] bg-white"></span>
    </span>
  </button>

  <button
    type="button"
    data-audio-step="1"
    class="hidden size-11 shrink-0 place-items-center rounded-full text-white/70 transition-colors hover:text-white sm:grid"
    aria-label={labels.next}
  >
    <svg viewBox="0 0 24 24" class="size-4 fill-current" aria-hidden="true">
      <path d="M15 6h2v12h-2zM7 6l8 6-8 6z"></path>
    </svg>
  </button>

  <p class="shrink-0 font-display text-sm tracking-[0.25em] text-white/80 tabular-nums">
    <span data-audio-time>{elapsed}</span>
    <span class="px-1 text-white/70">/</span>
    <span data-audio-duration>{duration}</span>
  </p>

  <span class="hidden h-12 w-px bg-white/30 sm:block" aria-hidden="true"></span>

  <div class="hidden min-w-0 flex-1 sm:block">
    <p
      data-audio-title
      class="mb-2 truncate font-display text-[0.7rem] tracking-[0.4em] text-white uppercase"
    >
      {track}
    </p>

    {/*
      A real slider, not a decorative bar: role, range, keyboard handling
      (arrows, Page keys, Home/End) and a visible focus ring. The waveform
      inside it is the value display.
    */}
    <div
      data-audio-seek
      role="slider"
      tabindex="0"
      aria-label={labels.seek}
      aria-valuemin="0"
      aria-valuemax="100"
      aria-valuenow="0"
      class="cursor-pointer py-1 focus-visible:outline-3 focus-visible:outline-offset-4 focus-visible:outline-cyan aria-disabled:cursor-default"
    >
      <Waveform progress={progress} />
    </div>
  </div>

  <button
    type="button"
    data-audio-mute
    aria-pressed="false"
    class="hidden size-11 shrink-0 place-items-center rounded-full ring-1 ring-white/40 transition-colors hover:ring-white aria-pressed:bg-white/10 sm:grid"
    aria-label={labels.mute}
  >
    <svg viewBox="0 0 24 24" class="size-4 fill-white" aria-hidden="true">
      <path d="M4 9v6h4l5 4V5L8 9H4Zm12.5 3a4.5 4.5 0 0 0-2.5-4v8a4.5 4.5 0 0 0 2.5-4Z"></path>
    </svg>
  </button>
</div>
