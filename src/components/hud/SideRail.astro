---
import type { Copy } from '../../i18n/copy';

interface Props {
  nav: Copy['nav'];
}

const { nav } = Astro.props;

/**
 * Which section belongs to which marker. The three factions share one, and
 * anything absent from the map hides the rail entirely - the card-grid
 * sections are not chapters and get no marker.
 */
const ownership = nav.rail.flatMap((marker) => marker.sections.map((section) => [section, marker.id] as const));
---

{
  /*
  Seven markers, numbered rather than dotted. The active one is ringed by the
  time.svg instrument - dashed ring, swept arc, lime diamond, two ticks
  reaching for the screen edge - drawn inline rather than loaded as an image
  so the arc can turn and the number can stay legible inside it. Its geometry
  is the file's, value for value; only the glyph that sat where the number
  goes has been left out.

  Each link carries its chapter name as real text, visually hidden, so the
  anchor text is descriptive rather than seven links all called "04".
*/
}
<nav
  data-slot="rail"
  data-visible="true"
  data-ownership={JSON.stringify(ownership)}
  class="fixed top-1/2 right-5 z-50 hidden -translate-y-1/2 md:block"
  aria-label={nav.progressLabel}
>
  <ol class="relative flex flex-col items-center gap-6">
    {
      nav.rail.map((marker, i) => (
        <li class="relative">
          <a
            href={`#${marker.id}`}
            data-rail-item={marker.id}
            class="group relative grid size-11 place-items-center font-display text-[0.7rem] tracking-[0.15em] text-white/60 tabular-nums transition-colors duration-300 hover:text-white data-[active]:text-white"
          >
            <span aria-hidden="true" data-part="index" class="transition-opacity duration-300">
              {String(i + 1).padStart(2, '0')}
            </span>
            <span class="sr-only">{marker.label}</span>

            {/*
              Placed by its own geometry, not by the box: the ring is centred
              at (24, 29) of a 50x53 frame, so the drawing is nudged by that
              difference to sit concentric with the 44px marker - and with the
              number in the middle of it - rather than with its own bounding
              box.

              The dashed ring is the dial. Everything that moves over it is
              one part: the lime diamond at the sweep's leading edge, the arc
              behind it, and the two ticks at its tail. They are drawn in the
              file at exactly those three positions, so grouping them is what
              the drawing already implied - and turning the group keeps the
              diamond, the arc and the ticks in step instead of leaving two of
              them stranded at twelve and three o'clock.

              The arc is the file's masked quadrant redrawn as a dash - same
              shape, but something CSS can turn. The 22/78 split is that
              quadrant's share of the circumference, and the offset of 22 is
              what lands it where the mask had it, ending at three o'clock,
              so the group needs no rotation of its own to sit at rest. See
              global.css for the sweep.
            */}
            <svg
              data-part="marker"
              viewBox="0 0 50 53"
              fill="none"
              aria-hidden="true"
              class="pointer-events-none overflow-visible absolute -top-[7px] -left-[2px] w-[50px] max-w-none opacity-0"
            >
              <circle opacity="0.5" cx="24" cy="29" r="23.5" stroke="white" stroke-dasharray="1 4" />

              <g data-part="sweep">
                <circle
                  cx="24"
                  cy="29"
                  r="23.5"
                  stroke="white"
                  pathLength="100"
                  stroke-dasharray="22 78"
                  stroke-dashoffset="22"
                />
                <path d="M29.293 6L24 11.293L18.707 6L24 0.707031L29.293 6Z" stroke="white" />
                <path d="M21 6L24 3L27 6L24 9L21 6Z" fill="#77E609" />
                <rect x="45" y="29" width="5" height="1" fill="white" />
                <rect x="46" y="31" width="3" height="1" fill="white" />
              </g>
            </svg>
          </a>
        </li>
      ))
    }
  </ol>
</nav>

<p class="fixed right-7 bottom-6 z-50 hidden size-11 rotate-45 place-items-center ring-1 ring-white/25 md:grid">
  <span class="-rotate-45 font-hud text-[0.65rem] tracking-[0.2em] text-white/70">
    {nav.language}
  </span>
</p>
