---
import type { Copy } from '../../i18n/copy';

interface Props {
  copy: Copy['media'];
}

const { copy } = Astro.props;
const networks = ['Facebook', 'Instagram', 'Twitter'];
---

{/* The contentinfo landmark sits outside <main>, after the closing section. */}
<footer data-slot="footer" class="relative border-t border-white/15 bg-white/5">
    <div
      class="mx-auto flex max-w-[110rem] flex-col gap-8 px-5 py-10 md:px-12 lg:flex-row lg:items-center lg:justify-between"
    >
      <form class="flex flex-1 flex-col gap-4 sm:flex-row sm:items-center">
        <label
          for="newsletter"
          class="font-display text-lg font-bold tracking-[0.25em] text-white uppercase"
        >
          {copy.newsletter.label}
        </label>
        <input
          id="newsletter"
          name="email"
          type="email"
          autocomplete="email"
          placeholder={copy.newsletter.placeholder}
          data-shape="slab-left"
          class="min-h-11 w-full max-w-sm bg-white/10 px-6 py-3 text-center font-display text-sm tracking-[0.15em] text-white placeholder:text-white/60 focus:bg-white/15"
        />
        <button
          type="submit"
          data-shape="slab"
          class="min-h-11 bg-white/15 px-8 py-3 font-display text-xs tracking-[0.35em] text-white uppercase ring-1 ring-white/30 ring-inset transition-colors hover:bg-white/25"
        >
          {copy.newsletter.submit}
        </button>
      </form>

      <div class="flex items-center gap-4">
        <span class="font-display text-xs tracking-[0.35em] text-white/70 uppercase">
          {copy.follow}
        </span>
        {
          networks.map((network) => (
            <a
              href="#credits"
              class="grid size-11 place-items-center rounded-sm bg-white/10 text-white transition-colors hover:bg-white/25"
            >
              <span class="font-display text-sm font-bold" aria-hidden="true">
                {network[0]}
              </span>
              <span class="sr-only">{network}</span>
            </a>
          ))
        }
      </div>
    </div>

    <div class="border-t border-white/15">
      <p
        class="mx-auto max-w-[110rem] px-5 py-6 font-display text-[0.7rem] tracking-[0.2em] text-white/60 uppercase md:px-12"
      >
        {copy.legal}
      </p>
    </div>
</footer>
