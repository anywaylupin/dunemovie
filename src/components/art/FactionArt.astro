---
/**
 * The layered background of one faction panel.
 *
 * Kept out of Factions.astro because it is four stacked layers per faction
 * and the section is already carrying a sticky stage, three scroll steps
 * and the emblem column. Everything it needs is looked up from
 * config/art.ts by faction id.
 *
 * Nothing here is announced: the panel's own aria-hidden toggling happens
 * one level up, and every layer is decorative.
 */
import { Image } from 'astro:assets';
import { factionArt } from '../../config/art';

interface Props {
  id: string;
  /** gradient stop list used when the faction has no artwork bound */
  wash: string;
}

const { id, wash } = Astro.props;
const art = factionArt[id];
---

{
  art ? (
    <div class="absolute inset-0 -z-10 overflow-hidden" aria-hidden="true">
      {/* Rock texture, laid across the whole frame and blended rather than
          placed - it is grain on the scene, not an object in it. */}
      {art.texture && (
        <Image
          src={art.texture}
          alt=""
          widths={[768, 1280]}
          sizes="100vw"
          loading="lazy"
          decoding="async"
          data-art="fade-left"
          class="absolute inset-0 h-full w-full object-cover opacity-35 mix-blend-overlay"
        />
      )}

      {/* House colour, washing in from the plate's side. */}
      <div
        class="absolute inset-0"
        style={`background-image:linear-gradient(270deg, ${art.tint} 0%, transparent 72%)`}
      >
      </div>

      <div
        class:list={[
          'absolute inset-y-0 right-0',
          art.layout === 'plate' ? 'w-full lg:w-[58%]' : 'w-full',
        ]}
        data-art={art.layout === 'plate' ? 'fade-left' : undefined}
      >
        <Image
          src={art.image}
          alt=""
          widths={[640, 1024, 1536]}
          sizes={art.layout === 'plate' ? '(min-width: 1024px) 58vw, 100vw' : '100vw'}
          loading="lazy"
          decoding="async"
          class="h-full w-full object-cover"
          style={`object-position:${art.position ?? 'center'}`}
        />
      </div>

      <Image
        src={art.circles}
        alt=""
        widths={[768, 1280, 1920]}
        sizes="100vw"
        loading="lazy"
        decoding="async"
        class="absolute inset-0 h-full w-full object-cover opacity-40 mix-blend-screen"
      />

      <div data-texture="hatch" class="absolute inset-0 opacity-10"></div>

      {/* Reading scrim for the pinned chapter copy in the left column. */}
      <div class="absolute inset-0 bg-linear-to-r from-void via-void/55 to-transparent"></div>
      <div class="absolute inset-x-0 bottom-0 h-1/3 bg-linear-to-t from-void to-transparent"></div>
    </div>
  ) : (
    <>
      <div class:list={['absolute inset-0 -z-10 bg-linear-to-br', wash]} aria-hidden="true" />
      <div data-texture="hatch" class="absolute inset-0 -z-10 opacity-25" aria-hidden="true" />
      <div
        class="absolute inset-0 -z-10 bg-linear-to-r from-void via-void/50 to-transparent"
        aria-hidden="true"
      />
    </>
  )
}
