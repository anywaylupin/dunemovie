---
import Section from '../ui/Section.astro';
import ChapterCopy from '../ui/ChapterCopy.astro';
import Backdrop from '../ui/Backdrop.astro';
import { backdropArt } from '../../config/art';
import type { Copy } from '../../i18n/copy';

interface Props {
  copy: Copy['caladan'];
  step: number;
}

const { copy, step } = Astro.props;
---

<Section id="caladan" chapter="caladan" label={copy.eyebrow} class="items-center">
  <Backdrop
    slot="backdrop"
    label="caladan — ocean world"
    art={backdropArt.caladan}
    wash="from-void via-slate-deep to-void"
    parallax={20}
  />

  <div
    class="mx-auto grid w-full max-w-[110rem] grid-cols-1 items-center gap-12 px-5 pt-28 pb-20 md:px-12 lg:grid-cols-[1fr_1fr]"
  >
    <ChapterCopy title={copy.title} body={copy.body} cta={copy.cta} />

    <div class="relative lg:col-start-2" data-anim="zoom-out" style="--anim-delay:200ms">
      <div
        class="absolute -top-24 -right-10 hidden size-[34rem] rounded-full bg-radial from-emerald-700/50 via-teal-900/40 to-transparent lg:block"
        aria-hidden="true"
      >
      </div>

      <div class="relative mx-auto max-w-xl">
        <div
          class="absolute -top-6 right-6 hidden h-full w-full bg-white/5 ring-1 ring-white/10 lg:block"
          aria-hidden="true"
        >
        </div>
        <article data-shape="notch" class="relative bg-void/60 p-3 ring-1 ring-white/20 ring-inset backdrop-blur-sm">
          <div class="relative">
            <div data-texture="hatch" class="aspect-video w-full bg-linear-to-br from-slate-500/40 to-void"></div>
            <button
              type="button"
              class="absolute top-1/2 left-1/2 grid size-14 -translate-x-1/2 -translate-y-1/2 place-items-center rounded-full ring-1 ring-white/40 transition-colors hover:bg-white/10"
              aria-label={copy.media}
            >
              <svg viewBox="0 0 24 24" class="size-5 fill-amber" aria-hidden="true">
                <path d="M8 5v14l11-7z"></path>
              </svg>
            </button>
            <h3 class="absolute inset-x-4 bottom-4 flex items-center gap-3 font-display text-lg font-semibold text-white">
              <span class="size-2 rotate-45 bg-white/80" aria-hidden="true"></span>
              {copy.media}
            </h3>
          </div>
        </article>

        <div class="mt-8 flex items-center gap-3" aria-hidden="true">
          <span class="grid size-6 place-items-center rounded-full ring-1 ring-white/30">
            <span class="size-2 rotate-45 bg-lime"></span>
          </span>
          <span class="h-px flex-1 bg-[repeating-linear-gradient(90deg,rgba(255,255,255,.4)_0_2px,transparent_2px_8px)]"></span>
        </div>
      </div>
    </div>
  </div>
</Section>
