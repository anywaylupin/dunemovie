---
import { Image } from 'astro:assets';
import { wordmark } from '../../config/art';

interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---

{/*
  The drawn wordmark, not letter-spaced type: the mark's D and E are cut
  through by the horizon rule, which no amount of tracking reproduces.

  The accessible name stays on the link — it says where the link goes, which
  is more use than repeating the title — so the image itself is decorative.
*/}
<a
  href="#hero"
  class:list={['block transition-opacity hover:opacity-70', className]}
  aria-label="Dune — back to top"
>
  <Image
    src={wordmark}
    alt=""
    width={236}
    height={32}
    densities={[1, 2]}
    loading="eager"
    decoding="sync"
    class="h-6 w-auto md:h-8"
  />
</a>
